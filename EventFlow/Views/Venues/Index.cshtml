@model IEnumerable<EventFlow.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h1>Venues</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Venue</a>
</p>

@if (!Model.Any())
{
    <p>No venues have been created yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var venue in Model)
            {
                <tr>
                    <td>@venue.Name</td>
                    <td>@venue.Address</td>
                    <td>@venue.City</td>
                </tr>
            }
        </tbody>
    </table>
}