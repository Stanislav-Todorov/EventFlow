@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Event
    </a>
</p>

@if (!Model.Any())
{
    <p>No events have been created yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Venue</th>
                <th>Starts</th>
                <th>Max Attendees</th>
                <th></th>
            </tr>
        </thead>


        <tbody>
            @foreach (var eventItem in Model)
            {
                <tr>
                    <td>@eventItem.Title</td>
                    <td>@eventItem.Category.Name</td>
                    <td>@eventItem.Venue.Name</td>
                    <td>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@eventItem.MaxAttendees</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@eventItem.Id">
                            Details
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}