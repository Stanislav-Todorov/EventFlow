@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Event
    </a>
</p>

<form asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search events..." />
    </div>

    <div class="col-md-3">
        <select name="categoryId"
                asp-items="ViewBag.Categories"
                class="form-select">
            <option value="">All categories</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="venueId"
                asp-items="ViewBag.Venues"
                class="form-select">
            <option value="">All venues</option>
        </select>
    </div>

    <div class="col-md-2">
        <select name="eventStatus"
                class="form-select">

            <option value="">All events</option>

            <option value="upcoming"
                    selected="@(ViewBag.EventStatus == "upcoming")">
                    Upcoming
            </option>

            <option value="ongoing"
                    selected="@(ViewBag.EventStatus == "ongoing")">
                    Ongoing
            </option>

            <option value="past"
                    selected="@(ViewBag.EventStatus == "past")">
                    Past
            </option>

        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>

</form>

@if (!Model.Any())
{
    <p>No events have been created yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Venue</th>
                <th>Starts</th>
                <th>Max Attendees</th>
                <th></th>
            </tr>
        </thead>


        <tbody>
            @foreach (var eventItem in Model)
            {
                <tr>
                    <td>@eventItem.Title</td>
                    <td>@eventItem.Category.Name</td>
                    <td>@eventItem.Venue.Name</td>
                    <td>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@eventItem.MaxAttendees</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@eventItem.Id">
                            Details
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}