@model EventFlow.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Title</h1>

<partial name="_EventStatusPartial"
         model="Model" />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Attendees</dt>
    <dd class="col-sm-9">
        @Model.Rsvps.Count / @Model.MaxAttendees
    </dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category.Name</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue.Name</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">
        @Model.Venue.Address, @Model.Venue.City
    </dd>

    <dt class="col-sm-3">Starts</dt>
    <dd class="col-sm-9">
        @Model.StartDateTime.ToString("dd MMMM yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">Ends</dt>
    <dd class="col-sm-9">
        @Model.EndDateTime.ToString("dd MMMM yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">Maximum attendees</dt>
    <dd class="col-sm-9">@Model.MaxAttendees</dd>
</dl>

@if (Model.EndDateTime < DateTime.Now)
{
    <div class="alert alert-secondary">
        This event has ended.
    </div>
}
else if (Model.Rsvps.Count >= Model.MaxAttendees)
{
    <div class="alert alert-warning">
        This event is fully booked.
    </div>
}
else
{
    <a asp-controller="Rsvps"
       asp-action="Create"
       asp-route-eventId="@Model.Id"
       class="btn btn-success">
        Register for Event
    </a>
}

<hr />

<h2>Attendees</h2>

@if (!Model.Rsvps.Any())
{
    <p>No one has registered for this event yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Registered On</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var rsvp in Model.Rsvps.OrderBy(r => r.RegisteredOn))
            {
                <tr>
                    <td>@rsvp.GuestName</td>
                    <td>@rsvp.GuestEmail</td>
                    <td>@rsvp.RegisteredOn.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <a asp-controller="Rsvps"
                           asp-action="Delete"
                           asp-route-id="@rsvp.Id"
                           class="btn btn-sm btn-outline-danger">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index">Back to Events</a>